#!/bin/bash
HOOKDIR=$(dirname "$0")

# Assumes that original clone has all submodules initialized, and not shallow
gitcommondir=$(git rev-parse --git-common-dir)

for external in third_party/llvm-project third_party/json third_party/third_party_bounds_checking_function third_party/sqlite3 cangjie_test_framework third_party/third_party_flatbuffers cangjie_tools; do
  git submodule update --init --reference=$gitcommondir/modules/$external $external
done

git submodule update --init --recommend-shallow

# Add relevant remotes to the submodules

(
unset $(git rev-parse --local-env-vars);
git -C cangjie_compiler remote add cjpluk-ssh git@github.com:CJPLUK/cangjie_compiler.git &> /dev/null
git -C cangjie_runtime remote add cjpluk-ssh git@github.com:CJPLUK/cangjie_runtime.git &> /dev/null
git -C cangjie_stdx remote add cjpluk-ssh git@github.com:CJPLUK/cangjie_stdx.git &> /dev/null
# git -C cangjie_tools remote add cjpluk-ssh # no repo on cjpluk github org

git -C cangjie_compiler remote add gitcode https://gitcode.com/Cangjie/cangjie_compiler.git &> /dev/null
git -C cangjie_runtime remote add gitcode https://gitcode.com/Cangjie/cangjie_runtime.git &> /dev/null
git -C cangjie_stdx remote add gitcode https://gitcode.com/Cangjie/cangjie_stdx.git &> /dev/null
git -C cangjie_tools remote add gitcode https://gitcode.com/Cangjie/cangjie_tools.git &> /dev/null
)


# Add branches to submodules with repos that we have write permissions to and set upstreams
if [ "-$3" = "-1" ]; then
  git branch | sed -n 's;\* \([^(].*\);\1;p' | if read branchname; then # (branchnames cannot start with '(')
    for submod in cangjie_compiler cangjie_runtime cangjie_stdx; do
      git submodule status $submod | sed -e '/^[+-]/d' | read unused && (
        unset $(git rev-parse --local-env-vars);
        echo "Adding branch '$branchname' to $submod (if not present)"
        git -C $submod switch -q -c $branchname 2>&1 | sed '/fatal: a branch named .* already exists/d'
      )
    done
  fi
fi
